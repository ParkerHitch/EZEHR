<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="EZEHR.Tests/**;EZEHR.Tools/**" />
    <Content Remove="EZEHR.Tests/**;EZEHR.Tools/**" />
    <None Remove="EZEHR.Tests/**;EZEHR.Tools/**" />
    <EmbeddedResource Remove="EZEHR.Tests/**;EZEHR.Tools/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Public CA certificates the network API trusts, loaded at runtime from the app's folder. -->
    <None Include="Security/Trust/*.pem" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" Version="4.10.2" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="EZCAClient" Version="1.0.14" />
    <PackageReference Include="Fido2.AspNet" Version="4.3.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" Version="11.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.2" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.18.0" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>
</Project>
