# Point the tools at the deployed site: `source scripts/azure.env`, then `ezehr-tools demo ...`.
# No secrets: the database uses Entra sign-in as whoever ran `az login` (they must be a database user, and
# this laptop's IP must be allowed through the ezehrdb firewall).
export EZEHR_BASE_URL=https://ezehr-ahhpereceshkdgbg.westus3-01.azurewebsites.net
export AZURE_SQL_CONNECTIONSTRING="Server=tcp:ezehrdb.database.windows.net,1433;Database=prod;Authentication=Active Directory Default;Encrypt=True"
