# Point the tools at the local stack (scripts/local.sh up, or the `tailscale` launch profile):
# `source scripts/local.env`, then `ezehr-tools demo stage`. The tools talk to Kestrel directly, never through the
# Tailscale proxy, because the network door needs the client certificate on the TLS connection itself.
export EZEHR_BASE_URL=https://localhost:7189
# Only protects the SQL container bound to 127.0.0.1 (same password as scripts/local.sh).
export AZURE_SQL_CONNECTIONSTRING="Server=127.0.0.1,1433;Database=ezehr;User Id=sa;Password=EzehrLocal-Dev-2026;TrustServerCertificate=True"
