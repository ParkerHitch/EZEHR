# Point the tools at EZEHR on the NUC (scripts/nuc-setup.sh): `source scripts/nuc.env`, then `ezehr-tools demo stage` (`ezehr-tools env` shows where it points).
# Run from the checkout. The SQL password comes from .pki/nuc-sql-password, copied from the NUC once:
#   scp colin-nuc:<checkout>/.pki/nuc-sql-password .pki/
# The tools reach the NUC over the tailnet: the site directly (mTLS needs that), SQL through `tailscale serve`.
NUC_DNS_NAME=colin-nuc.tail51bf60.ts.net
export EZEHR_BASE_URL="https://$NUC_DNS_NAME"
export AZURE_SQL_CONNECTIONSTRING="Server=$NUC_DNS_NAME,1433;Database=ezehr;User Id=sa;Password=$(cat "$(git rev-parse --show-toplevel)/.pki/nuc-sql-password");TrustServerCertificate=True"
