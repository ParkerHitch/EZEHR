@page
@model ErrorModel
@using EZEHR.Models
@{
  ViewData["Title"] = "Something went wrong";
}

<div class="patient-page">
  <h1 class="h3">Something went wrong</h1>
  <p>@Copy.SomethingWentWrong</p>
  <a class="btn btn-primary btn-tap" asp-page="/Index">Go to the home page</a>
  @if (Model.ShowRequestId)
  {
    <p class="text-muted small mt-4">Reference: <code>@Model.RequestId</code></p>
  }
</div>
