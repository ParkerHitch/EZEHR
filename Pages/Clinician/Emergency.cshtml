@page
@model EZEHR.Pages.Clinician.EmergencyModel
@using EZEHR.Managers
@using EZEHR.Models
@{
  ViewData["Title"] = "Emergency access";
}

<div class="clinician-page">
  <h1 class="h3">Emergency access</h1>
  <p class="text-muted">@Model.LaunchedFrom</p>
  <div class="alert alert-warning" role="note">@Copy.EmergencyAccessWarning</div>
  @if (Model.ErrorCopy is not null)
  {
    <div class="alert alert-danger" role="alert">@Model.ErrorCopy</div>
  }
  <form method="post" asp-route-launchId="@Model.LaunchId">
    <div class="mb-3">
      <label asp-for="Code" class="form-label">The patient's emergency code</label>
      <input asp-for="Code" class="form-control form-control-lg w-auto text-uppercase font-monospace"
             placeholder="XXXX-XXXX" autocomplete="off" autocapitalize="characters" spellcheck="false"
             maxlength="12" required autofocus/>
    </div>
    <div class="mb-3">
      <label asp-for="Reason" class="form-label">Why you need this record now</label>
      <textarea asp-for="Reason" class="form-control" rows="2"
                maxlength="@GrantManager.MaxEmergencyReasonLength" required></textarea>
    </div>
    <button type="submit" class="btn btn-danger btn-lg">Open the record</button>
    <a class="btn btn-link" asp-page="/Clinician/Redeem" asp-route-launchId="@Model.LaunchId">Cancel</a>
  </form>
</div>
