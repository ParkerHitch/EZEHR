@page
@model EZEHR.Pages.Clinician.RecordModel
@{
  ViewData["Title"] = "Patient record";
}

<div class="clinician-page"
     hx-get="@Url.Page("/Clinician/Record", "Status", new { patientId = Model.PatientId })"
     hx-trigger="every 2s" hx-swap="none">
  <h1 class="h3 mb-3">@Model.Header</h1>
  <partial name="_Timeline" model="Model.Timeline"/>
</div>
