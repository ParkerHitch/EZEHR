@page
@model EZEHR.Pages.Patient.HomeModel
@{
    ViewData["Title"] = "Your record";
}

<div class="patient-page">
    <partial name="_PatientNav"/>
    <h1 class="h4 mb-3">@Model.Home.PatientName</h1>
    <a class="btn btn-outline-primary btn-tap mb-3" asp-page="/Patient/Home" asp-page-handler="Export">Export my record</a>
    <partial name="_HomeTimeline" model="Model.Home"/>
</div>
