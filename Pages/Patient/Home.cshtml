@page
@model EZEHR.Pages.Patient.HomeModel
@{
    ViewData["Title"] = "Your record";
}

<div class="patient-page">
    <h1 class="h3">@Model.PatientName</h1>
    <p>You're signed in.</p>
    <form method="post" asp-page-handler="SignOut">
        <button type="submit" class="btn btn-outline-secondary btn-tap">Sign out</button>
    </form>
</div>
