@{
  string? currentPage = ViewContext.RouteData.Values["page"] as string;
  (string Path, string Label)[] tabs =
  [
    ("/Patient/Home", "Record"),
    ("/Patient/Share", "Share"),
    ("/Patient/Activity", "Activity"),
    ("/Patient/Grants", "Access"),
  ];
}

<nav class="nav nav-pills nav-fill mb-3 patient-nav">
  @foreach ((string path, string label) in tabs)
  {
    <a class="nav-link @(path == currentPage ? "active" : "")" aria-current="@(path == currentPage ? "page" : null)" asp-page="@path">@label</a>
  }
</nav>
<form method="post" asp-page="/Patient/SignIn" asp-page-handler="SignOut" class="text-end mb-2">
  <button type="submit" class="btn btn-link btn-tap">Sign out</button>
</form>
