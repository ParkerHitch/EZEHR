@page
@using EZEHR.Models
@model EZEHR.Pages.Patient.GrantsModel
@{
    ViewData["Title"] = "Access";
}

<div class="patient-page">
    <partial name="_PatientNav"/>
    <h1 class="h4">Who can see your record</h1>
    @if (!Model.Lines.Any(line => line.CanRevoke))
    {
        <p class="text-muted">No clinicians. Share a code when you want one to see it.</p>
    }
    <ul class="list-group mb-4">
        @foreach (AccessLine line in Model.Lines.Where(line => line.CanRevoke))
        {
            <li class="list-group-item d-flex justify-content-between align-items-center gap-2 @(line.Emergency ? "list-group-item-warning" : "")">
                <span>@line.Text</span>
                <form method="post" asp-page-handler="Revoke">
                    <input type="hidden" name="grantId" value="@line.GrantId"/>
                    <button class="btn btn-outline-danger btn-tap">Revoke</button>
                </form>
            </li>
        }
    </ul>
    @if (Model.Lines.Any(line => !line.CanRevoke))
    {
        <h2 class="h6 text-muted">Ended</h2>
        <ul class="list-group mb-4">
            @foreach (AccessLine line in Model.Lines.Where(line => !line.CanRevoke))
            {
                <li class="list-group-item text-muted">@line.Text</li>
            }
        </ul>
    }

    <h2 class="h5">Apps</h2>
    <p class="text-muted small">@Copy.AppsHint</p>
    <ul class="list-group mb-4">
        <li class="list-group-item">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                <span class="fw-semibold">Kidney Check</span>
                @if (Model.KidneyCheck is not null)
                {
                    <span class="badge text-bg-success">On</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Off</span>
                }
            </div>
            @if (Model.KidneyCheck is AccessLine kidneyCheck)
            {
                <p class="mb-2">@kidneyCheck.Text</p>
                <form method="post" asp-page-handler="Revoke">
                    <input type="hidden" name="grantId" value="@kidneyCheck.GrantId"/>
                    <button class="btn btn-outline-secondary btn-tap">@Copy.TurnOffKidneyCheck</button>
                </form>
            }
            else
            {
                <p class="mb-2">@Copy.KidneyOptIn</p>
                <form method="post" asp-page-handler="TurnOnKidneyCheck">
                    <button class="btn btn-primary btn-tap">@Copy.TurnOnKidneyCheck</button>
                </form>
            }
        </li>
    </ul>

    <h2 class="h5">Emergency access</h2>
    <ul class="list-group mb-4">
        <li class="list-group-item">
            @if (Model.EmergencyCode is not null)
            {
                <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                    <span class="fs-4 font-monospace">@Model.EmergencyCode</span>
                    <span class="badge text-bg-success">On</span>
                </div>
                <p class="mb-2">@Copy.EmergencyAccessOnHint</p>
                <div class="d-flex flex-wrap gap-2">
                    <form method="post" asp-page-handler="TurnOnEmergencyAccess">
                        <button class="btn btn-outline-secondary btn-tap">@Copy.NewEmergencyCode</button>
                    </form>
                    <form method="post" asp-page-handler="TurnOffEmergencyAccess">
                        <button class="btn btn-outline-secondary btn-tap">@Copy.TurnOffEmergencyAccess</button>
                    </form>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                    <span class="fw-semibold">Emergency code</span>
                    <span class="badge text-bg-secondary">Off</span>
                </div>
                <p class="mb-2">@Copy.EmergencyAccessOffHint</p>
                <form method="post" asp-page-handler="TurnOnEmergencyAccess">
                    <button class="btn btn-primary btn-tap">@Copy.TurnOnEmergencyAccess</button>
                </form>
            }
        </li>
    </ul>

    <h2 class="h5">Connected providers</h2>
    <p class="text-muted small">@Copy.ConnectedProvidersHint</p>
    @if (!Model.ConnectedProviders.Any())
    {
        <p class="text-muted">@Copy.NoConnectedProviders</p>
    }
    <ul class="list-group">
        @foreach (ConnectedProviderLine provider in Model.ConnectedProviders)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                <span>@provider.Text</span>
                <form method="post" asp-page-handler="Disconnect">
                    <input type="hidden" name="providerUri" value="@provider.ProviderUri"/>
                    <button class="btn btn-outline-secondary btn-tap">Disconnect</button>
                </form>
            </li>
        }
    </ul>
</div>
